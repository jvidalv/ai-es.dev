{
  "name": "ai-es",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "check:rules": "bun scripts/check-rules.ts",
    "check:comment-length": "bun scripts/check-comment-length.ts",
    "check:comment-density": "bun scripts/check-comment-density.ts",
    "check:vite-config": "bun scripts/check-vite-config.ts",
    "check:staged": "bun scripts/check-staged.ts",
    "check:push-gates": "bun scripts/run-push-gates.ts",
    "hooks:install": "git config core.hooksPath .githooks",
    "dev": "bun run --filter @ai-es/web dev",
    "build": "bun run --filter @ai-es/web build",
    "preview": "bun run --filter @ai-es/web preview",
    "start": "bun run --filter @ai-es/web start",
    "content": "bun run --filter @ai-es/web content",
    "news:generate": "bun run --filter @ai-es/news generate",
    "news:discord": "bun run --filter @ai-es/news discord",
    "verify:build": "bun run --filter @ai-es/web verify:build",
    "check": "bun run content && vp check",
    "test": "vp test run",
    "typecheck": "bun run content && tsc -b"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "~6.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0",
    "vite-plus": "1.0.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0"
  },
  "engines": {
    "bun": ">=1.4.2",
    "node": ">=24 <25"
  },
  "packageManager": "bun@1.4.2"
}
